@idp = http://localhost:8080/realms/brp-api/protocol/openid-connect/token
@client_id = client%20met%20gemeentecode%20(eigen%20gemeente)
@client_secret = secret
@scope = 000000099000000080000
@abonnees_endpoint = http://localhost:8002/api/brp/abonnees
@abonnee_naam = dbz
@groep_naam = client
@gebeurtenistype = nl.brp.verhuisd.intergemeentelijk
@burgerservicenummer = 999997348
### Fetch access token
# @name auth

POST {{idp}}
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&client_id={{client_id}}&client_secret={{client_secret}}&scope={{scope}}

### Registreer abonnee

POST {{abonnees_endpoint}}
Authorization: Bearer {{auth.response.body.access_token}}
Content-Type: application/json

{
  "naam": "{{abonnee_naam}}"
}

### Raadpleeg abonnees

GET {{abonnees_endpoint}}
Authorization: Bearer {{auth.response.body.access_token}}

### Raadpleeg groepen
GET {{abonnees_endpoint}}/{{abonnee_naam}}/groepen
Authorization: Bearer {{auth.response.body.access_token}}

### Groep toewijzen aan abonnee

POST {{abonnees_endpoint}}/{{abonnee_naam}}/groepen
Authorization: Bearer {{auth.response.body.access_token}}
Content-Type: application/json

{
  "naam": "{{groep_naam}}"
}

### Raadpleeg gebeurtenistypes in groep

GET {{abonnees_endpoint}}/{{abonnee_naam}}/groepen/{{groep_naam}}/gebeurtenistypes
Authorization: Bearer {{auth.response.body.access_token}}

### Voeg gebeurtenistype toe aan groep

POST {{abonnees_endpoint}}/{{abonnee_naam}}/groepen/{{groep_naam}}/gebeurtenistypes
Authorization: Bearer {{auth.response.body.access_token}}
Content-Type: application/json

{
  "gebeurtenistype": "{{gebeurtenistype}}"
}

### Verwijder gebeurtenistype uit groep

DELETE {{abonnees_endpoint}}/{{abonnee_naam}}/groepen/{{groep_naam}}/gebeurtenistypes/{{gebeurtenistype}}
Authorization: Bearer {{auth.response.body.access_token}}

### Abonneer persoon op groep
POST {{abonnees_endpoint}}/{{abonnee_naam}}/abonnementen
Authorization: Bearer {{auth.response.body.access_token}}
Content-Type: application/json

{
  "type": "AbonneerPersoonOpGroep",
  "groep": "{{groep_naam}}",
  "burgerservicenummer": "{{burgerservicenummer}}"
}

### Abonneer op verhuisd.intergemeentelijk gebeurtenis van 999997348

POST http://localhost:8888/api/brp/abonnees/dbz/abonnementen
Authorization: Bearer {{auth.response.body.access_token}}
Content-Type: application/json

{
  "type": "AbonneerOpGebeurtenisTypeVanPersoon",
  "gebeurtenisType": "nl.brp.verhuisd.intergemeentelijk",
  "burgerservicenummer": "999997348"
}

### Raadpleeg abonnementen van abonnee dbz

GET http://localhost:8888/api/brp/abonnees/dbz/abonnementen
Authorization: Bearer {{auth.response.body.access_token}}

### Aangifte van adreswijziging

POST http://localhost:8000/api/brp/personen/aangiftes
Authorization: Bearer {{auth.response.body.access_token}}
Content-Type: application/json

{
  "type": "AangifteVanAdreswijziging",
  "burgerservicenummer": "999997348",
  "verhuisdatum": "2026-01-01",
  "adresseerbaarObjectIdentificatie": "034401000012651"
}

### Gebeurtenissen bevragen

GET http://localhost:8888/api/brp/abonnees/dbz/gebeurtenissen
Authorization: Bearer {{auth.response.body.access_token}}

###

POST http://localhost:8002/personen/gebeurtenissen
Content-Type: application/json

{
  "type": "nl.brp.verhuisd.intergemeentelijk"
}

###
POST http://localhost:8002/actuator/gebeurtenissen/reset
Content-Type: application/json

{
}
